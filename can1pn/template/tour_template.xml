<?xml version="1.0" encoding="UTF-8"?>

<krpano title="Virtual Tour" version="1.23">
  <!-- <include url="FloorPlan/xml/floorplan_SM.xml" /> -->

  <display depthmaprendermode="3dmodel" />
  <display depthbuffer="true" />
  <action autorun="onstart" name="startup">
    loadscene(get(scene[0].name),null,null,BLEND(0.5));
    set(view.tx,get(image.ox));
    set(view.ty,get(image.oy));
    set(view.tz,get(image.oz));
    js(readyAddScene());
  </action>

	<include url="%VIEWER%/plugins/webvr.xml" />
	
	<!-- overwrite/redesign the default Enter VR button from the webvr.xml -->
	<layer name="webvr_enterbutton" keep="true"
		url="icon_vr.png"
		scale="0.08" scalechildren="false" align="leftbottom" x="18" y="18" alpha="1.0"
		onclick.addevent="set(display.anaglyph,false);"
		/>

	<layer name="webvr_enterbutton_infotext" keep="true" devices="normal"
		parent="webvr_enterbutton"
		type="text" css="color:#FFFFFF;font-size:10px;line-height:12px;" bg="false" txtshadow="0 1 4 0x000000 1.0"
		html="Enter[br]VR Mode"
		align="lefttop" x="45" y="8" capture="false"
		/>
    
	<style name="polyspot"
		capture="false"
		borderwidth="0"
		alpha="0"
		onover="if(webvr.isenabled == false, tween(alpha,0.3));"
		onout="tween(alpha,0);"
		onclick="loadscene(get(linkedscene),null,MERGE|PRELOAD|KEEPMOVING,COLORBLEND(2.0, 0x000000, easeOutSine));"
		/>


  <scene model="true" name="scene_008" onstart="showFlootHotspot();"
    thumburl="%HTMLPATH%/panos/8.tiles/thumb.jpg" title="scene8" type="panorama">
